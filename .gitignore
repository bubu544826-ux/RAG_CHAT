# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local environment files and secrets
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg-info/

# Coverage output
.coverage
htmlcov/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime data is local and should not be committed
data/*
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
